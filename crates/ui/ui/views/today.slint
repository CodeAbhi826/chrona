import { Theme, AppItem, CatItem, HourItem, ArcItem } from "../theme.slint";
import { Card, ProgressRing, Donut, HBar, HourBar, AppRow, StatChip } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component TodayView inherits Rectangle {
    in property <string> date-text;
    in property <string> total-text;
    in property <string> ring-cmd;
    in property <string> ring-caption;
    in property <string> unlocks-text;
    in property <string> longest-text;
    in property <string> current-window;
    in property <[AppItem]> apps;
    in property <[CatItem]> cats;
    in property <[ArcItem]> cat-arcs;
    in property <[HourItem]> hourly;
    background: transparent;

    ScrollView {
        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                spacing: 16px;
                Card {
                    title: "Screen time — " + root.date-text;
                    preferred-width: 330px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        Rectangle {
                            height: 240px;
                            ProgressRing {
                                size: 216px;
                                progress-cmd: root.ring-cmd;
                                x: (parent.width - self.width) / 2;
                                y: 6px;
                            }
                            Text {
                                text: root.total-text;
                                font-size: 36px;
                                font-weight: 700;
                                color: Theme.text;
                                x: (parent.width - self.width) / 2;
                                y: 86px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.ring-caption;
                                font-size: 13px;
                                color: Theme.text-dim;
                                x: (parent.width - self.width) / 2;
                                y: 138px;
                                horizontal-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            StatChip { caption: "unlocks"; value: root.unlocks-text; }
                            StatChip { caption: "longest session"; value: root.longest-text; }
                        }
                        Text {
                            text: root.current-window != "" ? "Right now: " + root.current-window : "";
                            font-size: 12px;
                            color: Theme.text-dim;
                            overflow: elide;
                        }
                    }
                }
                Card {
                    title: "Top apps";
                    vertical-stretch: 1;
                    if root.apps.length == 0: Text {
                        text: "No apps recorded yet — keep using your desktop.";
                        color: Theme.text-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        for a in root.apps: AppRow {
                            name: a.name;
                            share: a.share;
                            time-text: a.seconds-text;
                            dot-color: Theme.accent;
                        }
                    }
                }
                Card {
                    title: "Categories";
                    preferred-width: 280px;
                    if root.cats.length == 0: Text {
                        text: "Nothing categorised yet.";
                        color: Theme.text-dim;
                        font-size: 13px;
                    }
                    VerticalLayout {
                        spacing: 10px;
                        Rectangle {
                            height: 168px;
                            Donut {
                                size: 160px;
                                arcs: root.cat-arcs;
                                x: (parent.width - self.width) / 2;
                                hole-color: Theme.surface;
                                Text {
                                    text: "today";
                                    color: Theme.text-dim;
                                    font-size: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            for c in root.cats: HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 9px; height: 9px; border-radius: 5px;
                                    background: Theme.cat-color(c.key, Theme.dark);
                                    y: parent.height / 2 - 4.5px;
                                }
                                Text { text: c.label; color: Theme.text; font-size: 12.5px; }
                                Text {
                                    text: c.pct-text;
                                    color: Theme.text-dim;
                                    font-size: 12.5px;
                                    horizontal-alignment: right;
                                    width: 76px;
                                }
                            }
                        }
                    }
                }
            }
            Card {
                title: "Timeline — activity by hour";
                height: 190px;
                if root.hourly.length == 0: Text {
                    text: "No activity yet today.";
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                Rectangle {
                    height: 118px;
                    HorizontalLayout {
                        spacing: 4px;
                        for h in root.hourly: HourBar { v: h.v; }
                    }
                    Rectangle {
                        y: parent.height + 6px;
                        width: parent.width;
                        height: 16px;
                        HorizontalLayout {
                            spacing: 4px;
                            for h in root.hourly: Text {
                                text: h.label;
                                font-size: 10px;
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
