import { Theme, AppItem, DayItem } from "../theme.slint";
import { Card, AppRow, StackSeg } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component WeekView inherits Rectangle {
    in property <[DayItem]> days;
    in property <[AppItem]> apps;
    in property <string> total-text;
    in property <string> avg-text;
    in property <string> delta-text;
    in property <bool> delta-up;
    background: transparent;

    ScrollView {
        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                spacing: 16px;
                Card {
                    title: "This week";
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.total-text;
                            font-size: 32px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: root.avg-text;
                            font-size: 13px;
                            color: Theme.text-dim;
                        }
                        Text {
                            text: root.delta-text;
                            font-size: 13px;
                            color: root.delta-up ? Theme.danger : Theme.ok;
                        }
                    }
                    preferred-width: 280px;
                }
                Card {
                    title: "Per-day usage (stacked by category)";
                    vertical-stretch: 1;
                    if root.days.length == 0: Text {
                        text: "No data for this week yet.";
                        color: Theme.text-dim;
                        font-size: 13px;
                    }
                    Rectangle {
                        height: 220px;
                        HorizontalLayout {
                            spacing: 12px;
                            for d in root.days: Rectangle {
                                vertical-stretch: 1;
                                Rectangle {
                                    y: 20px;
                                    height: 150px;
                                    width: parent.width;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Theme.surface-2;
                                    for c in d.cats: StackSeg {
                                        v: c.v;
                                        y0: c.y0;
                                        seg-color: Theme.cat-color(c.key, Theme.dark);
                                        width: parent.width;
                                        height: parent.height;
                                        y: 0;
                                    }
                                }
                                Text {
                                    text: d.label;
                                    y: 178px;
                                    width: parent.width;
                                    horizontal-alignment: center;
                                    font-size: 11.5px;
                                    color: Theme.text-dim;
                                }
                                Text {
                                    text: d.seconds-text;
                                    y: 194px;
                                    width: parent.width;
                                    horizontal-alignment: center;
                                    font-size: 11px;
                                    color: Theme.text;
                                }
                            }
                        }
                    }
                }
            }
            Card {
                title: "Most used apps — week";
                if root.apps.length == 0: Text {
                    text: "No apps yet this week.";
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                VerticalLayout {
                    spacing: 2px;
                    for a in root.apps: AppRow {
                        name: a.name;
                        share: a.share;
                        time-text: a.seconds-text;
                        icon: a.icon;
                        has-icon: a.has-icon;
                    }
                }
            }
        }
    }
}
