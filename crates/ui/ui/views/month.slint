import { Theme, AppItem, WeekColumn } from "../theme.slint";
import { Card, AppRow } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component MonthView inherits Rectangle {
    in property <string> label;
    in property <string> total-text;
    in property <string> avg-text;
    in property <string> busiest-text;
    in property <[WeekColumn]> weeks;
    in property <[AppItem]> apps;
    background: transparent;

    ScrollView {
        VerticalLayout {
            spacing: 16px;
            HorizontalLayout {
                spacing: 16px;
                Card {
                    title: root.label;
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.total-text;
                            font-size: 32px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text { text: root.avg-text; font-size: 13px; color: Theme.text-dim; }
                        Text { text: root.busiest-text; font-size: 13px; color: Theme.text-dim; }
                    }
                    preferred-width: 260px;
                }
                Card {
                    title: "Usage calendar";
                    vertical-stretch: 1;
                    Rectangle {
                        height: 190px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for w in root.weeks: Rectangle {
                                width: 26px;
                                height: 100%;
                                VerticalLayout {
                                    spacing: 6px;
                                    for c in w.cells: Rectangle {
                                        height: 22px;
                                        border-radius: 6px;
                                        background: c.v > 0
                                            ? Theme.accent.with-alpha(0.12 + 0.88 * min(1, c.v))
                                            : Theme.surface-2;
                                        border-width: c.is-today ? 2px : 0px;
                                        border-color: Theme.accent;
                                    }
                                }
                            }
                        }
                        Text {
                            y: parent.height - 18px;
                            text: "darker = more screen time";
                            font-size: 10.5px;
                            color: Theme.text-dim;
                        }
                    }
                }
            }
            Card {
                title: "Most used apps — month";
                if root.apps.length == 0: Text {
                    text: "No apps yet this month.";
                    color: Theme.text-dim;
                    font-size: 13px;
                }
                VerticalLayout {
                    spacing: 2px;
                    for a in root.apps: AppRow {
                        name: a.name;
                        share: a.share;
                        time-text: a.seconds-text;
                        icon: a.icon;
                        has-icon: a.has-icon;
                    }
                }
            }
        }
    }
}
