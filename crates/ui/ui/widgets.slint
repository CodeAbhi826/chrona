// Reusable Chrona widgets: cards, rings, bars, nav items, chips.
import { Theme, ArcItem } from "theme.slint";

export component Card inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 0px;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        if root.title != "": Text {
            text: root.title;
            color: Theme.text-dim;
            font-size: 12.5px;
            font-weight: 600;
        }
        @children
    }
}

/// Circular progress ring (Google Digital Wellbeing style). Arc geometry is
/// generated in Rust as an SVG path command (`arc_cmd`) on a 100×100 viewbox.
export component ProgressRing inherits Rectangle {
    in property <string> progress-cmd: "";
    in property <length> size: 200px;
    in property <color> track-color: Theme.surface-2;
    in property <color> progress-color: Theme.accent;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: -1;
        viewbox-y: -1;
        viewbox-width: 102;
        viewbox-height: 102;
        stroke: track-color;
        stroke-width: 10px;
        fill: transparent;
        commands: "M 50 5 A 45 45 0 1 1 49.99 5.01";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: -1;
        viewbox-y: -1;
        viewbox-width: 102;
        viewbox-height: 102;
        stroke: progress-color;
        stroke-width: 10px;
        fill: transparent;
        commands: root.progress-cmd;
    }
}

/// Category donut: arcs generated in Rust, colored per category key.
export component Donut inherits Rectangle {
    in property <length> size: 160px;
    in property <[ArcItem]> arcs;
    in property <color> hole-color: Theme.surface;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: -1;
        viewbox-y: -1;
        viewbox-width: 102;
        viewbox-height: 102;
        stroke: Theme.surface-2;
        stroke-width: 10px;
        fill: transparent;
        commands: "M 50 5 A 45 45 0 1 1 49.99 5.01";
    }
    for a in root.arcs: Path {
        width: 100%;
        height: 100%;
        viewbox-x: -1;
        viewbox-y: -1;
        viewbox-width: 102;
        viewbox-height: 102;
        stroke: Theme.cat-color(a.key, Theme.dark);
        stroke-width: 10px;
        fill: transparent;
        commands: a.cmd;
    }
    Rectangle {
        width: 58%; height: 58%; border-radius: self.width / 2;
        background: hole-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

/// Horizontal usage bar.
export component HBar inherits Rectangle {
    in property <float> share: 0;
    in property <color> bar-color: Theme.accent;
    height: 8px;
    border-radius: 4px;
    background: Theme.surface-2;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * min(1, max(0, share));
        border-radius: parent.height / 2;
        background: bar-color;
    }
}

/// One vertical hour bar for the timeline.
export component HourBar inherits Rectangle {
    in property <float> v: 0;
    in property <color> bar-color: Theme.accent;
    height: 96px;
    border-radius: 4px;
    background: Theme.surface-2;
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * min(1, v);
        y: parent.height - self.height;
        border-radius: 4px;
        background: root.bar-color;
    }
}

/// One stacked column segment position (absolute, inside a fixed-height column).
export component StackSeg inherits Rectangle {
    in property <float> v;      // fraction of column height
    in property <float> y0;     // bottom offset fraction
    in property <color> seg-color;
    Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height * min(1, v);
        y: parent.height - self.height - parent.height * y0;
        border-radius: 3px;
        background: seg-color;
    }
}

/// Sidebar navigation item.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 42px;
    border-radius: 14px;
    background: active ? Theme.accent : (touch.has-hover ? Theme.surface-2 : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 11px;
        alignment: start;
        Rectangle {
            width: 9px; height: 9px; border-radius: 5px;
            background: active ? Theme.on-accent : (touch.has-hover ? Theme.text-dim : Theme.stroke);
            y: parent.height / 2 - 4.5px;
        }
        Text {
            text: label;
            vertical-alignment: center;
            color: active ? Theme.on-accent : Theme.text-dim;
            font-size: 14px;
            font-weight: active ? 700 : 500;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Small stat chip used under the Today ring.
export component StatChip inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    height: 64px;
    border-radius: Theme.radius;
    background: Theme.surface-2;
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        alignment: center;
        Text {
            text: value;
            font-size: 17px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: caption;
            font-size: 11px;
            color: Theme.text-dim;
        }
    }
}

/// Row: colored dot + name + bar + time (app usage rows).
export component AppRow inherits Rectangle {
    in property <string> name;
    in property <float> share;
    in property <string> time-text;
    in property <color> dot-color: Theme.accent;
    in property <bool> selected: false;
    in property <bool> clickable: false;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: selected ? Theme.accent-soft : (touch.has-hover && clickable ? Theme.surface-2 : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 10px; height: 10px; border-radius: 5px;
            background: dot-color;
            y: parent.height / 2 - 5px;
        }
        Text {
            text: name;
            width: 110px;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.text;
            font-size: 13px;
        }
        HBar {
            share: root.share;
        }
        Text {
            text: time-text;
            width: 62px;
            vertical-alignment: center;
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: right;
        }
    }
    touch := TouchArea {
        mouse-cursor: clickable ? pointer : default;
        clicked => { if (clickable) { root.clicked(); } }
    }
}
